<?xml version="1.0" encoding="utf-8"?>
<!-- The instrumented tests only. The HTTP tests talk to a plain-socket stub on 127.0.0.1, so the test
     APK allows cleartext to the loopback address and nowhere else. The library and app never merge this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/test_network_security" />
</manifest>
