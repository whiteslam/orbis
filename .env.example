# Orbis environment variables. Copy this file to .env.local and fill in what
# you need; .env.local is git-ignored. Required = the app won't start or a core
# path breaks without it. Optional = a feature quietly stands down without it.

# ── Required ──────────────────────────────────────────────────────────────────

# Supabase project. The publishable key is safe in the browser; the secret key
# is server-only and must never be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The app's own canonical origin: http://localhost:3000 locally, the deployed
# HTTPS origin in production. Used in auth redirects, the CSP, metadata, the
# sitemap and OG image, and Gmail/Zerodha callback URLs.
NEXT_PUBLIC_SITE_URL=

# Signs the app-lock cookie. At least 32 characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it the key is derived from SUPABASE_SECRET_KEY, so rotating that would
# lock everyone out. Set it explicitly in production.
APP_LOCK_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Shown on the public Support and Privacy pages; without it they say "through
# the support page" instead of an address.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Set automatically by Next.js/Vercel and Node itself (development, production,
# test). You don't need to set this yourself; it's listed here only because the
# code reads it directly in a few places (secure cookies, the CSP, site URL
# fallback).
NODE_ENV=

# Private build. Leave empty and anyone can create an account and sign in, as
# normal. Set it and Orbis is closed: sign-up is off entirely, and only these
# addresses can sign in. Anyone already signed in who is not listed is signed
# out on their next request. Separate several with commas or spaces.
ORBIS_ALLOWED_EMAILS=

# Guards /api/notifications/dispatch so only your scheduler can trigger a send.
# Required if you schedule the daily notifications.
CRON_SECRET=

# Gmail transaction-alert connection (read-only). Separate from Supabase Auth;
# Google Cloud must allow GOOGLE_REDIRECT_URI as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/gmail/callback
# Encrypts stored Gmail/Zerodha tokens. CREDENTIAL_ENCRYPTION_KEY overrides it
# if both are set. Changing either after connections exist makes them unreadable.
GMAIL_TOKEN_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# AI router. Anything built from your own data (the brief, plans, workbook
# advice, portfolio suggestions) is routed only to a provider the ai_providers
# registry marks may_train = false. Today that is Groq, so without this key
# those features stand down rather than sending your data somewhere that keeps
# it. AI also stays off for every account until they turn it on once in
# Profile → Settings (migration 202609280203_ai_consent.sql), independent of
# whether any key below is set.
GROQ_API_KEY=
# Optional extra providers for the router. These may train on what they
# receive, so the router only uses them for work that is not personal.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Document search sends your document text to OpenRouter for embedding, and the
# registry marks it as a provider that may train on what it receives. Off unless
# you set this to true. See the note in lib/health-docs/embeddings.ts.
ORBIS_ALLOW_EXTERNAL_EMBEDDINGS=false
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Groww holdings sync.
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_OWNER_EMAIL=

# Market data for the Invest tab.
ALPHA_VANTAGE_API_KEY=

# Zerodha Kite Connect. Key and secret alone are not enough to read holdings:
# Kite issues an access token only through an interactive login that expires
# each morning, so a connection needs that flow, not just these two values.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Web push notifications. Generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
