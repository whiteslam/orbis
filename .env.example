NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_LOCK_SECRET=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SITE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=
# AI. Anything built from your own data (the brief, plans, workbook advice,
# portfolio suggestions) is routed only to a provider the ai_providers registry
# marks may_train = false. Today that is Groq, so without this key those
# features stand down rather than sending your data somewhere that keeps it.
GROQ_API_KEY=
# Optional extra providers for the router. These may train on what they receive,
# so the router only uses them for work that is not personal.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Document search sends your document text to OpenRouter for embedding, and the
# registry marks it as a provider that may train on what it receives. Off unless
# you set this to true. See the note in lib/health-docs/embeddings.ts.
ORBIS_ALLOW_EXTERNAL_EMBEDDINGS=false
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_OWNER_EMAIL=
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Private build ────────────────────────────────────────────────────────────
# Leave empty and anyone can create an account and sign in, as normal.
# Set it and Orbis is closed: sign-up is off entirely, and only these addresses
# can sign in. Anyone already signed in who is not listed is signed out on their
# next request. Separate several with commas or spaces.
ORBIS_ALLOWED_EMAILS=

# Zerodha Kite Connect. Key and secret alone are not enough to read holdings:
# Kite issues an access token only through an interactive login that expires
# each morning, so a connection needs that flow, not just these two values.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Guards /api/notifications/dispatch so only your scheduler can trigger a send.
# Required if you schedule the daily notifications.
CRON_SECRET=

# Signs the app-lock cookie. At least 32 characters. Without it the key is
# derived from SUPABASE_SECRET_KEY, so rotating that would lock everyone out.
APP_LOCK_SECRET=

# Encrypts stored credentials. Falls back to GMAIL_TOKEN_ENCRYPTION_KEY.
# Changing it after connections exist makes them unreadable.
CREDENTIAL_ENCRYPTION_KEY=
