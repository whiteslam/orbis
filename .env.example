# Orbis environment variables. Copy this file to .env.local and fill in what
# you need; .env.local is git-ignored. Required = the app won't start or a core
# path breaks without it. Optional = a feature quietly stands down without it.

# ── Required ──────────────────────────────────────────────────────────────────

# Supabase project. The publishable key is safe in the browser; the secret key
# is server-only and must never be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The app's own canonical origin: http://localhost:3000 locally, the deployed
# HTTPS origin in production. Used in auth redirects, the CSP, metadata, the
# sitemap and OG image, and Gmail/Zerodha callback URLs.
NEXT_PUBLIC_SITE_URL=

# Signs the app-lock cookie. At least 32 characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it the key is derived from SUPABASE_SECRET_KEY, so rotating that would
# lock everyone out. Set it explicitly in production.
APP_LOCK_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Shown on the public Support and Privacy pages; without it they say "through
# the support page" instead of an address.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Set automatically by Next.js/Vercel and Node itself (development, production,
# test). You don't need to set this yourself; it's listed here only because the
# code reads it directly in a few places (secure cookies, the CSP, site URL
# fallback).
NODE_ENV=

# Who may sign in. Leave empty and anyone who already has an account can sign
# in. Set it and Orbis is closed: only these addresses get in, and anyone
# already signed in who is not listed is signed out on their next request.
# Separate several with commas or spaces. Set this on a deployment you use
# yourself; an empty list is not a private app.
ORBIS_ALLOWED_EMAILS=

# Whether anyone may create an account. Off unless this is exactly 'true', and
# an ORBIS_ALLOWED_EMAILS list turns it off regardless. Leave it unset: the
# public front door is the waitlist, and accounts are made deliberately.
ORBIS_OPEN_SIGNUPS=

# Guards /api/notifications/dispatch so only your scheduler can trigger a send.
# Required if you schedule the daily notifications.
CRON_SECRET=

# Gmail transaction-alert connection (read-only). Separate from Supabase Auth;
# Google Cloud must allow GOOGLE_REDIRECT_URI as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/gmail/callback
# Encrypts stored Gmail/Zerodha tokens. CREDENTIAL_ENCRYPTION_KEY overrides it
# if both are set. Changing either after connections exist makes them unreadable.
GMAIL_TOKEN_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# AI router. Anything built from your own data (the brief, plans, workbook
# advice, portfolio suggestions) is routed only to a provider the ai_providers
# registry marks may_train = false. Today that is Groq, so without this key
# those features stand down rather than sending your data somewhere that keeps
# it. AI also stays off for every account until they turn it on once in
# Profile → Settings (migration 202609280203_ai_consent.sql), independent of
# whether any key below is set.
GROQ_API_KEY=
# Optional extra providers for the router. These may train on what they
# receive, so the router only uses them for work that is not personal.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Claude Haiku, the paid reliability layer. Two ways to reach it:
#  - through OpenRouter with OPENROUTER_API_KEY above (migration
#    202610010032_openrouter_haiku.sql, pinned to Anthropic with data collection
#    denied), or
#  - directly with ANTHROPIC_API_KEY below (202610010031_ai_paid_models.sql).
# With neither, Orbis uses free models only, exactly as before. Claude is used
# within a monthly budget: after every free model has failed below ₹500, and
# first for Ask Orbis, health plans and advice from ₹500 up. At 80% of the
# budget Claude becomes a last resort; once it is spent, only free models run.
# Anthropic's commercial API does not train on what it receives by default, so
# Claude may see personal data; see the migration to change that.
ANTHROPIC_API_KEY=
# Monthly AI budget in rupees. 0 turns paid models off. Default 300.
ORBIS_AI_MONTHLY_BUDGET_INR=300
# Optional: 'fallback' (Claude only after free models fail) or 'quality'
# (Claude first for quality features). Defaults by budget: below 500 fallback.
ORBIS_AI_PAID_ROUTING=
# Jev (TypeSafe's decision model, through OPENROUTER_API_KEY) reads an Ask or
# Talk question, never the records, and decides whether it needs Claude: yes
# puts Claude first, no keeps free models first. About $0.00002 a question,
# counted in the budget, always with zero data retention. 'off' disables it.
ORBIS_JEV=
# The Jev release to use. Pinned so a new release cannot change routing unannounced.
ORBIS_JEV_MODEL=typesafe/jev-1.13
# Rupees per US dollar, to compare the dollar-priced bill with the budget.
# Set it to your card's rate; 88 is only a placeholder default.
ORBIS_AI_USD_INR=88

# Document search sends your document text to OpenRouter for embedding, and the
# registry marks it as a provider that may train on what it receives. Off unless
# you set this to true. See the note in lib/health-docs/embeddings.ts.
ORBIS_ALLOW_EXTERNAL_EMBEDDINGS=false
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Groww holdings sync.
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_OWNER_EMAIL=

# Market data for the Invest tab.
ALPHA_VANTAGE_API_KEY=

# Headlines for Home's News card and the news brief on Investments. Free plan at
# https://newsdata.io (200 credits a day, commercial use allowed); Orbis uses
# about 16 a day, shared by every user. Without it the News card says so.
NEWSDATA_API_KEY=

# Zerodha Kite Connect. Key and secret alone are not enough to read holdings:
# Kite issues an access token only through an interactive login that expires
# each morning, so a connection needs that flow, not just these two values.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Web push notifications. Generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Voice (Talk to Orbis): Sarvam speech-to-text and text-to-speech. Leave empty to hide the mic.
SARVAM_API_KEY=

# ── Publishing to Instagram and Threads ──────────────────────────────────────
# Both are Meta APIs behind App Review: instagram_business_content_publish and
# threads_content_publish only work for the app's own testers until Meta
# approves them. Instagram uses Instagram Login, so it needs a Business or
# Creator account but no Facebook Page. Each has its own app id and secret,
# separate from the Meta app's: Instagram's are under Instagram API → API setup
# with Instagram login, Threads' under the Threads API use case's settings.
#
# The redirect URIs must match the app settings exactly:
#   https://your-site/auth/social/instagram/callback
#   https://your-site/auth/social/threads/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
